# ─────────────────────────────────────────────────────────────
# Sip Güain 3.0 · Variables de entorno
# Copia este archivo a .env.local (local) o configúralas en Vercel.
# ─────────────────────────────────────────────────────────────

# URL pública del sitio (canonical, Open Graph, sitemap, robots).
# Local: http://localhost:3000 · Producción: https://sipguain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pon "false" para bloquear la indexación aunque el entorno sea de producción
# (útil mientras la 3.0 convive con el sitio actual).
NEXT_PUBLIC_ALLOW_INDEXING=false

# ── Formulario de contacto (Resend · https://resend.com) ──
# Sin estas tres variables el formulario valida pero responde
# "envío no configurado" y NO afirma haber enviado nada.
RESEND_API_KEY=
# Destinatario(s), separados por coma.
CONTACT_TO_EMAIL=contacto@sipguain.com
# Remitente verificado en Resend (dominio propio verificado).
CONTACT_FROM_EMAIL="Sip Güain <web@sipguain.com>"
